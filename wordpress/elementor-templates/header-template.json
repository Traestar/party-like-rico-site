{
  "version": "0.4",
  "title": "PLR – Site Header",
  "type": "header",
  "content": [
    {
      "id": "hdr-sec-01",
      "elType": "section",
      "isInner": false,
      "settings": {
        "_title": "Header – Main Nav",
        "background_background": "classic",
        "background_color": "rgba(11,15,20,0.97)",
        "layout": "full_width",
        "content_width": { "unit": "px", "size": 1240, "sizes": [] },
        "padding": { "unit": "px", "top": "0", "right": "24", "bottom": "0", "left": "24", "isLinked": false },
        "border_bottom_width": { "unit": "px", "size": 1 },
        "border_color": "rgba(250,204,21,0.15)",
        "z_index": 999,
        "css_classes": "plr-header"
      },
      "elements": [
        {
          "id": "hdr-col-logo",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 25,
            "content_position": "middle",
            "padding": { "unit": "px", "top": "16", "right": "0", "bottom": "16", "left": "0", "isLinked": false }
          },
          "elements": [
            {
              "id": "hdr-w-logo",
              "elType": "widget",
              "widgetType": "site-logo",
              "settings": {
                "width": { "unit": "px", "size": 160, "sizes": [] },
                "width_tablet": { "unit": "px", "size": 130, "sizes": [] },
                "align": "left",
                "caption_source": "none",
                "css_classes": "plr-logo"
              },
              "elements": []
            }
          ]
        },
        {
          "id": "hdr-col-nav",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 58,
            "content_position": "middle",
            "align": "center"
          },
          "elements": [
            {
              "id": "hdr-w-nav",
              "elType": "widget",
              "widgetType": "nav-menu",
              "settings": {
                "menu": "primary",
                "layout": "horizontal",
                "align_items": "center",
                "indicator": "chevron",
                "text_align": "center",
                "submenu_icon": { "value": "fas fa-chevron-down", "library": "fa-solid" },
                "text_color": "#D1D5DB",
                "text_hover_color": "#FACC15",
                "text_active_color": "#FACC15",
                "pointer": "none",
                "animation_duration": 300,
                "padding_horizontal_menu_item": { "unit": "px", "size": 14, "sizes": [] },
                "typography_typography": "custom",
                "typography_font_family": "Inter",
                "typography_font_size": { "unit": "px", "size": 14, "sizes": [] },
                "typography_font_weight": "500",
                "dropdown_background_color": "#0F1623",
                "dropdown_border_color": "rgba(250,204,21,0.2)",
                "dropdown_text_color": "#E5E7EB",
                "dropdown_text_hover_color": "#FACC15",
                "dropdown_background_hover_color": "rgba(250,204,21,0.08)",
                "css_classes": "plr-nav"
              },
              "elements": []
            }
          ]
        },
        {
          "id": "hdr-col-cta",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 17,
            "content_position": "middle",
            "align": "right"
          },
          "elements": [
            {
              "id": "hdr-w-btn",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "🎟 Tickets",
                "link": {
                  "url": "https://www.paypal.com/ncp/payment/AWCDNEHMYVWAG",
                  "is_external": true,
                  "nofollow": false,
                  "custom_attributes": ""
                },
                "align": "right",
                "size": "sm",
                "background_color": "#FACC15",
                "button_text_color": "#0B0F14",
                "border_radius": { "unit": "px", "top": 8, "right": 8, "bottom": 8, "left": 8, "isLinked": true },
                "padding": { "unit": "px", "top": "10", "right": "20", "bottom": "10", "left": "20", "isLinked": false },
                "typography_typography": "custom",
                "typography_font_family": "Montserrat",
                "typography_font_weight": "700",
                "typography_font_size": { "unit": "px", "size": 13, "sizes": [] },
                "css_classes": "plr-btn-gold"
              },
              "elements": []
            }
          ]
        }
      ]
    }
  ],
  "page_settings": {}
}
